 letter.","AccountCreation.Email.EndWith":"Email address must end with a letter or number.","AccountCreation.Email.CatchAll":"Email address can only contain unaccented letters, numbers, periods, and underscores.","AccountCreation.Email.ConsecutiveDots":"Email address cannot have two consecutive periods (..).","AccountCreation.Email.ConsecutiveUnderscore":"Email address cannot have two consecutive underscores (__).","AccountCreation.Suggestion.Failure":"Unable to load suggestions.","AccountCreation.ImportMail.Button.Label":"Import Messages","LegalFooter.StatusUrl.Title":"System Status","LegalFooter.PrivacyUrl.Title":"Privacy Policy","LegalFooter.TermsUrl.Title":"Terms & Conditions","LegalFooter.Copyright":"Copyright © %{currentYear} Apple Inc. All rights reserved.","SchoolLegalFooter.TermsUrl.Title":"Terms and Conditions for Schools","BusinessLegalFooter.TermsUrl.Title":"Terms and Conditions for Businesses","VoiceOver.ExternalLink.Description":"(opens in a new tab)","Categorization.InlineTip.Title":"Your Inbox Is Organized with Categories","Categorization.InlineTip.Description":"Browse messages with focused views. You’ll find all personal and time-sensitive messages in the Primary category.","Categorization.InlineTip.Button.OK":"About Categories","CategorizationConsent.InlineTip.Title":"Categorize Your Inbox","CategorizationConsent.InlineTip.Description":"Organize your inbox by category to easily find the messages you’re looking for.","CategorizationConsent.InlineTip.Button.OK":"Use Categories","Categorization.CategorizeSender.Title":"Categorize a Sender","Categorization.CategorizeSender.Description":"Click on #{moreButton} and look for #{categorizeButton} to categorize all current and future messages from a sender.","Categorization.OnboardingModal.Title":"About Categories","Categorization.OnboardingModal.Description":"Categories help you find the messages that matter most in Primary and organize everything else into Transactions, Updates, and Promotions. #{learnMore}","Categorization.OnboardingModal.LearnMore":"Learn More","Categorization.OnboardingModal.Primary.Heading":"Primary","Categorization.OnboardingModal.Primary.Description":"Stay focused on the people and subjects that matter most when messages are categorized as Primary.","Categorization.OnboardingModal.Transactions.Heading":"Transactions","Categorization.OnboardingModal.Transactions.Description":"Keep track of your purchases, including receipts and delivery updates, when you bundle messages by sender.","Categorization.OnboardingModal.Updates.Heading":"Updates","Categorization.OnboardingModal.Updates.Description":"Stay updated and organized with a place for every subscription, newsletter, and social media alert.","Categorization.OnboardingModal.Promotions.Heading":"Promotions","Categorization.OnboardingModal.Promotions.Description":"Browse special offers, events, and more from the businesses and organizations you might recognize.","Categorization.OnboardingModal.TimeSensitive.Heading":"Time-Sensitive Messages","Categorization.OnboardingModal.TimeSensitive.Description":"When a message in Transactions, Updates or Promotions includes time-sensitive information, it will also appear in Primary.","Categorization.RestoreCategoryRules.Confirmation.Title":"Reset Manual Categorization","Categorization.RestoreCategoryRules.Confirmation.Description":"Current and future messages from senders in this iCloud Mail account will be recategorized to the default setting.","Categorization.RestoreCategoryRules.Confirmation.Warning":"This change only applies to messages and categorization in your iCloud Mail account. This action cannot be undone.","Categorization.RestoreCategoryRules.Error.Title":"Cannot restore automatic categorization.","Categorization.RestoreCategoryRules.Error.Description":"Your manual overrides cannot be reset at this time. Try again later.","Categorization.ConsentModal.Tile":"Introducing Categories","Categorization.ConsentModal.Description":"Find the messages that matter most in Primary and organize everything else into Transactions, Updates, and Promotions.","Categorization.Consent.V1.DataHandling.link":"See how your data is managed…","Categorization.Consent.V1.DataHandling.link.url":"https://www.apple.com/legal/privacy/data/en/mail-categorization","Categorization.Consent.V1.DataHandling.greyText":"Apple processes certain email metadata in order to help organize your emails into categories. This metadata does not include the body content of your emails.","Categorization.ConsentModal.Button.UseCategories":"Turn On","Categorization.CategoryPicker.Title":"Recategorize %{senderName}","Categorization.CategoryPicker.Title.Multiple":"Recategorize %{senderCount} Senders","Categorization.CategoryPicker.Description":"This applies to all current and future messages from selected senders.","Categorization.CategoryPicker.Automatic.Title":"Automatically","Categorization.CategoryPicker.Automatic.Description":"Automatically categorize across all 4 categories","Categorization.CategoryPicker.Manual.Title":"Manually","Categorization.CategoryPicker.Manual.Description":"Categorize to a specific category","Categorization.DragDropConfirmation.Popup.Title":"Recategorize %{senderName} to %{targetCategoryName}","Categorization.DragDropConfirmation.Popup.Description":"When you drag and drop to recategorize senders, the change will apply to all current and future messages from selected senders","Categorization.DragDropConfirmation.Popup.Title.Multiple":"Recategorize %{senderCount} Senders to %{targetCategoryName}","Categorization.UpdateMenu.Sender.Feedback":"[Internal] File Radar + Categorize Sender as","Categorization.Feedback.HighImpact":"High Impact","Categorization.Feedback.Not.HighImpact":"Not High Impact","Toolbar.Button.Category.Feedback.Label":"[Internal] Provide Miscategorization Feedback","Categorization.Progress.TakeOver.Title":"iCloud Mail is Organizing Your Inbox with Categories","Categorization.Progress.TakeOver.Description.5Minutes":"Categorizing your messages typically takes about 5 minutes.","Categorization.Progress.TakeOver.Description.1Hour":"Categorizing your messages typically takes about an hour.","Categorization.Progress.TakeOver.Description.Unknown":"This may take some time.","FilterView.Option.Thread":"Group by Thread","FilterView.Option.Sender":"Group by Sender"});var p4,h4,m4=n(1968),g4=n(1986);function v4(e,t){return t||(t=e.slice(0)),e.raw=t,e}function y4(e,t,n,r,i,o,a){try{var s=e[o](a),u=s.value}catch(c){return void n(c)}s.done?t(u):Promise.resolve(u).then(r,i)}function b4(e){return function(){var t=this,n=arguments;return new Promise((function(r,i){var o=e.apply(t,n);function a(e){y4(o,r,i,a,s,"next",e)}function s(e){y4(o,r,i,a,s,"throw",e)}a(void 0)}))}}function w4(e){return C4.apply(this,arguments)}function C4(){return(C4=b4(regeneratorRuntime.mark((function e(t){var n,r,i,o,a,s,u,c,l;return regeneratorRuntime.wrap((function(e){for(;;)switch(e.prev=e.next){case 0:return n=t.itemId,r=t.version,i=t.uploadProgress,o=cT(h4||(h4=v4(["v1/snapshot_link/","/",""])),n,r),a=o.unprotectedString,s=o.protectedString,u=Ll("docws",a),c="/"+s,e.next=6,Ay(u,{method:"POST",didProgress:function(e){if(e.uploadProgress){var t=Math.round(100*e.uploadProgress.percentComplete);i(t)}},reportingPathname:c},_4);case 6:return l=e.sent,e.abrupt("return",l);case 8:case"end":return e.stop()}}),e)})))).apply(this,arguments)}!function(e){e.Remove="Remove",e.Insert="Insert"}(p4||(p4={}));var _4=fy.type({url_preview:fy.string,url_download:fy.string,expires_at:fy.string});function S4(e,t,n,r,i,o,a){try{var s=e[o](a),u=s.value}catch(c){return void n(c)}s.done?t(u):Promise.resolve(u).then(r,i)}function E4(e){return function(){var t=this,n=arguments;return new Promise((function(r,i){var o=e.apply(t,n);function a(e){S4(o,r,i,a,s,"next",e)}function s(e){S4(o,r,i,a,s,"throw",e)}a(void 0)}))}}function O4(e){return I4.apply(this,arguments)}function I4(){return(I4=E4(regeneratorRuntime.mark((function e(t){var n,r,i,o,a;return